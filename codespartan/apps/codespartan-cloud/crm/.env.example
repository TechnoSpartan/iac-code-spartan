TAG=v0.50.0
SERVER_URL=https://crm.codespartan.cloud

# PostgreSQL (dedicated instance for Twenty)
PG_USER=twenty
PG_PASSWORD=change_me_strong_password

# Encryption (openssl rand -base64 32)
ENCRYPTION_KEY=change_me_random_64_chars

STORAGE_TYPE=local

# Access model (CodeSpartan)
# - Edge: Authelia ForwardAuth on crm.codespartan.cloud (Traefik)
# - App: single workspace, no public self-signup; invite teammates in Twenty UI
IS_MULTIWORKSPACE_ENABLED=false
IS_SIGN_UP_DISABLED=true

# Runtime via Twenty Admin Panel (not always env):
# - SMTP Brevo for CRM emails
# - Microsoft 365 OAuth (calendar/mail sync)
# - API key for dental-ia lead ingestion: Settings → API & Webhooks
