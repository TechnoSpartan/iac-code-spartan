NODE_ENV=production
TZ=Europe/Madrid

JOB_HUNTER_BOT_IMAGE=ghcr.io/technospartan/job-hunter-bot:latest
JOB_HUNTER_DASHBOARD_IMAGE=ghcr.io/technospartan/job-hunter-dashboard:latest

JOB_HUNTER_API_HOST=api.codespartan.cloud
JOB_HUNTER_DASHBOARD_HOST=dashboard.codespartan.cloud

DATABASE_PATH=/app/data/job-hunter.db

BOT_API_HOST=0.0.0.0
BOT_API_PORT=3101
BOT_API_CORS_ORIGIN=https://dashboard.codespartan.cloud
BOT_API_TOKEN=CHANGE_ME

BOT_METRICS_PORT=9102

NEXT_PUBLIC_BOT_API_URL=https://api.codespartan.cloud
NEXT_PUBLIC_BOT_API_TOKEN=CHANGE_ME

# LLM providers
LLM_PROVIDER=multi
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# Scraper API keys
FREELANCER_API_KEY=
REED_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRON_SCHEDULE=0 8 * * *
