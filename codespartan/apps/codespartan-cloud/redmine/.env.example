# Redmine Docker Configuration
# ⚠️  IMPORTANT: This file is for REFERENCE ONLY
#
# Create a .env file locally (DO NOT COMMIT to git):
#   cp .env.example .env
#   # Edit .env with REAL production values
#   # Keep .env in .gitignore (never commit credentials)
#
# For GitHub deployment, add secrets in GitHub Settings:
#   Settings → Secrets and variables → Actions
#
# Add these secrets:
#   - REDMINE_POSTGRES_PASSWORD
#   - REDMINE_SECRET_KEY_BASE
#   - REDMINE_SMTP_PASSWORD

# ============================================
# Traefik Configuration
# ============================================
# The hostname for this Redmine instance (replacing OpenProject)
TRAEFIK_HOSTNAME=project.codespartan.cloud

# ============================================
# PostgreSQL Configuration
# ============================================
# Database name
POSTGRES_DB=redmine

# Database user
POSTGRES_USER=redmine

# Database password - CHANGE THIS TO A STRONG PASSWORD!
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change_me_to_a_strong_password_12345

# ============================================
# Redmine Configuration
# ============================================
# External hostname (same as TRAEFIK_HOSTNAME for production)
REDMINE_HOSTNAME=project.codespartan.cloud

# Default language (en, es, de, fr, ja, pt-BR, etc.)
# Options: en, es, de, fr, it, ja, ko, nl, pl, pt, pt-BR, ru, zh, zh-TW
REDMINE_LANG=en

# Rails Secret Key Base - CHANGE THIS!
# Generate with: openssl rand -hex 64
REDMINE_SECRET_KEY_BASE=change_me_to_a_long_random_string_min_64_characters_generated_with_openssl

# ============================================
# Email Configuration (SMTP via Brevo)
# ============================================
# Brevo (formerly Sendinblue) SMTP relay
# Dashboard: https://app.brevo.com/settings/keys/smtp
# Generate an SMTP key in Brevo → Settings → SMTP & API → SMTP tab
SMTP_ADDRESS=smtp-relay.brevo.com

# SMTP port (587 for STARTTLS - Hetzner firewall only allows outbound 587)
SMTP_PORT=587

# SMTP domain (your verified sender domain, used in HELO/EHLO)
SMTP_DOMAIN=codespartan.es

# SMTP authentication method: 'login' or 'plain'
SMTP_AUTHENTICATION=login

# SMTP username = Brevo SMTP login (format: xxxxxxxx@smtp-brevo.com)
# Find it in Brevo dashboard: Settings → SMTP & API → SMTP tab
# The sender email (noreply@codespartan.es) must be verified in Brevo dashboard
SMTP_USERNAME=xxxxxxxx@smtp-brevo.com

# SMTP password = Brevo SMTP key (starts with xsmtpsib-...)
# ⚠️  DO NOT commit this to git - use .gitignore and GitHub Secrets
SMTP_PASSWORD=xsmtpsib-xxxxxxxx

# Use TLS encryption (false for port 587 with STARTTLS)
SMTP_TLS=false

# ============================================
# Performance Notes
# ============================================
# Resource Limits (configured in docker-compose.yml):
#   - redmine-app:  512MB RAM, 0.5 CPU (much lighter than OpenProject's 1.2GB)
#   - redmine-db:   256MB RAM, 0.5 CPU (much lighter than OpenProject's 384MB)
#
# Total: ~768MB vs OpenProject's 1.7GB+ (55% reduction)
