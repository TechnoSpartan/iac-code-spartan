# Postgres
POSTGRES_USER=dental_lab
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=dental_lab

# Auth
JWT_SECRET=changeme_random_secret
JWT_EXPIRES_IN=1h

# IA (Anthropic real en producción)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# URLs públicas (enlaces de respuesta que reciben los pacientes por email)
CORS_ORIGIN=https://lab.dental-ia.es
PUBLIC_BASE_URL=https://lab.dental-ia.es

# Email saliente (opcional — sin ella, el proveedor de email cae a modo consola)
BREVO_API_KEY=

# Automatizaciones
AUTOMATIONS_SCAN_INTERVAL_MS=300000
